{
  "name": "hanword",
  "version": "0.6.0",
  "description": "한글(HWPX)과 Word(DOCX) 모두 호환되는 문서 편집기",
  "scripts": {
    "embed": "node scripts/embed-templates.mjs",
    "predev": "npm run embed",
    "dev": "vite",
    "prebuild": "npm run embed",
    "build": "vite build",
    "typecheck": "tsc",
    "presamples": "npm run embed",
    "samples": "tsx verify/build-samples.ts",
    "verify": "npm run samples && npm run roundtrip && python3 verify/verify.py && npm run render:hwpx",
    "render:hwpx": "node verify/render-hwpx.mjs",
    "build:artifact": "npm run build && node scripts/make-artifact.mjs",
    "roundtrip": "tsx verify/roundtrip.ts",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "inspect": "tsx verify/inspect.ts",
    "release": "node scripts/release.mjs",
    "build:cli": "npm run embed && node scripts/build-cli.mjs",
    "convert": "tsx cli/hanword-cli.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/extension-text-align": "^3.32.1",
    "@tiptap/extension-text-style": "^3.32.1",
    "@tiptap/html": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "docx": "^9.15.0",
    "jszip": "^3.10.2",
    "marked": "^18.1.2"
  },
  "devDependencies": {
    "@rhwp/core": "^0.8.7",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "private": true,
  "type": "module"
}
